                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE không công bố lợi nhuận hay chi phí riêng của từng kênh, nên trang này không so sánh khả năng sinh lời giữa các kênh.",
                    "textStyle": {
