                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE Direct gồm cửa hàng và Digital",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#15191e",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE chỉ công bố doanh số Digital trong phần MD&A và làm tròn đến 0,1 tỷ USD. Trong 10-K FY2024, số FY2023 được trình bày lại từ 12,6 xuống 12,4 tỷ USD, nên khi so FY2024 (12,1 tỷ USD) với năm trước cần dùng số 12,4 để cùng cách phân loại.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "5pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Theo báo cáo và loại trừ tỷ giá",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "11pt",
                      "color": "#15191e",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Tăng trưởng theo báo cáo được tính từ doanh thu năm nay và số năm trước trong cùng 10-K. Tăng trưởng loại trừ tỷ giá là chỉ tiêu non-GAAP do NIKE tính, nhóm không tự tính lại được.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": " ",
