          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Lợi nhuận",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#5b6472",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "“Additionally, the favorable impact of growth in our higher margin NIKE Direct business, led by NIKE owned Digital, was more than offset by higher promotions in our factory stores during the first half of fiscal 2021 to reduce excess inventory as a result of COVID‑19.”",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#15191e",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE Direct, dẫn đầu là Digital, có biên lợi nhuận cao hơn. Nhưng trong FY2021, phần lợi từ tăng trưởng của NIKE Direct bị lấn át bởi việc tăng khuyến mại ở cửa hàng outlet nửa đầu năm để giảm tồn kho dư do COVID‑19.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE, 10‑K FY2021, tr. 34 · ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.5pt",
                      "color": "#5b6472"
                    }
                  },
                  {
                    "value": "mở trên SEC",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.5pt",
                      "color": "#2a78d6"
                    },
                    "url": "https://www.sec.gov/Archives/edgar/data/320187/000032018721000028/nke-20210531.htm"
