    "objects": {
      "general": [
        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Vì sao",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#5b6472",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "“In the current marketplace environment, we believe there continues to be a meaningful shift in the way consumers shop for product and make purchasing decisions. Consumers are demanding a constant flow of fresh and innovative product, and have an expectation for superior service and rapid delivery, all fueled by the shift toward digital and mono-brand experiences in NIKE Direct.”",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#15191e",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE cho rằng cách người tiêu dùng mua sắm vẫn đang thay đổi rõ rệt. Họ đòi hỏi sản phẩm mới liên tục, dịch vụ tốt, giao hàng nhanh, tất cả được thúc đẩy bởi xu hướng chuyển sang trải nghiệm Digital và trải nghiệm chỉ một thương hiệu (mono-brand) trong NIKE Direct.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE, 10‑K FY2019, tr. 31 · ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.5pt",
                      "color": "#5b6472"
                    }
                  },
                  {
                    "value": "mở trên SEC",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.5pt",
                      "color": "#2a78d6"
                    },
                    "url": "https://www.sec.gov/Archives/edgar/data/320187/000032018719000051/nke-531201910k.htm"
                  }
                ],
