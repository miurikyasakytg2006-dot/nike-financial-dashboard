            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Chi phí",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#5b6472",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "“Demand creation expense decreased 13% for fiscal 2021, due to lower marketing and advertising expenses for our brand events and retail operations, as well as lower sports marketing expense as sporting events were postponed due to COVID‑19.”",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#15191e",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Chi phí tạo nhu cầu FY2021 giảm 13%: chi marketing và quảng cáo cho sự kiện thương hiệu và hoạt động bán lẻ giảm, chi tài trợ thể thao cũng giảm vì các giải đấu bị hoãn do COVID‑19.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE, 10‑K FY2021, tr. 34 · ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
