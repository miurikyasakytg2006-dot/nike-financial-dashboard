            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Chiến lược",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "9.5pt",
                      "color": "#5b6472",
                      "fontWeight": "bold"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "“Through the Consumer Direct Offense, we are focusing on our Triple Double strategy, with the objective of doubling the impact of innovation, increasing our speed to market and growing our direct connections with consumers.”",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10.5pt",
                      "color": "#15191e",
                      "fontStyle": "italic"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Thông qua Consumer Direct Offense, NIKE tập trung vào chiến lược “Triple Double”, với mục tiêu nhân đôi tác động của đổi mới, đưa hàng ra thị trường nhanh hơn và tăng kết nối trực tiếp với người tiêu dùng.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "10pt",
                      "color": "#3b4350"
                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "NIKE, 10‑K FY2019, tr. 24 · ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.5pt",
                      "color": "#5b6472"
                    }
                  },
                  {
                    "value": "mở trên SEC",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8.5pt",
                      "color": "#2a78d6"
                    },
                    "url": "https://www.sec.gov/Archives/edgar/data/320187/000032018719000051/nke-531201910k.htm"
                  }
