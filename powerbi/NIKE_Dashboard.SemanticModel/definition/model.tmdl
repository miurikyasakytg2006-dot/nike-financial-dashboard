model Model
	culture: vi-VN
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: vi-VN
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation PBI_QueryOrder = ["Nam","Quy","ThayDoi","CauNoi","KhuVuc","BangNam","BangQuy","BangKhuVuc","BaoCao"]

annotation __PBI_TimeIntelligenceEnabled = 0

ref table Nam
ref table Quy
ref table ThayDoi
ref table CauNoi
ref table KhuVuc
ref table BangNam
ref table BangQuy
ref table BangKhuVuc
ref table BaoCao
