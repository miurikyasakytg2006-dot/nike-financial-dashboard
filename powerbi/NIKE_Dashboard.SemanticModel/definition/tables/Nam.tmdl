table Nam

	measure 'Tỷ trọng NIKE Direct' = SUM ( Nam[direct_share] )
		formatString: 0.0%

	measure 'Tỷ trọng bán buôn' = SUM ( Nam[wholesale_share] )
		formatString: 0.0%

	measure 'Tỷ trọng Global Brand Divisions' = SUM ( Nam[gbd_share] )
		formatString: 0.00%

	measure 'NIKE Direct (tỷ USD)' = DIVIDE ( SUM ( Nam[nike_direct_revenue] ), 1000 )
		formatString: #,0.0

	measure 'Bán buôn (tỷ USD)' = DIVIDE ( SUM ( Nam[nike_brand_wholesale_revenue] ), 1000 )
		formatString: #,0.0

	measure 'NIKE Brand (tỷ USD)' = DIVIDE ( SUM ( Nam[nike_brand_revenue] ), 1000 )
		formatString: #,0.0

	measure 'Tăng trưởng NIKE Direct' = SUM ( Nam[direct_growth] )
		formatString: +0.0%;−0.0%;0.0%

	measure 'Tăng trưởng bán buôn' = SUM ( Nam[wholesale_growth] )
		formatString: +0.0%;−0.0%;0.0%

	measure 'Digital (tỷ USD)' = SUM ( Nam[nike_brand_digital_sales] )
		formatString: #,0.0

	measure 'Phần còn lại của NIKE Direct (tỷ USD)' = DIVIDE ( SUM ( Nam[direct_ex_digital] ), 1000 )
		formatString: #,0.0

	measure 'Digital trong NIKE Direct' = SUM ( Nam[digital_share_of_direct] )
		formatString: 0%

	measure 'Doanh thu (tỷ USD)' = DIVIDE ( SUM ( Nam[revenues] ), 1000 )
		formatString: #,0.0

	measure 'Biên lợi nhuận gộp' = SUM ( Nam[gross_margin] )
		formatString: 0.0%

	measure 'Biên EBIT' = SUM ( Nam[ebit_margin] )
		formatString: 0.0%

	measure 'Hàng tồn kho (tỷ USD)' = DIVIDE ( SUM ( Nam[inventories] ), 1000 )
		formatString: #,0.0

	measure 'So với cùng thời điểm năm trước' = SUM ( Nam[inventory_growth] )
		formatString: +0.0%;−0.0%;0.0%

	measure 'Số ngày tồn kho' = SUM ( Nam[days_inventory] )
		formatString: 0

	measure 'Giá vốn hàng bán (tỷ USD)' = DIVIDE ( SUM ( Nam[cost_of_sales] ), 1000 )
		formatString: #,0.00

