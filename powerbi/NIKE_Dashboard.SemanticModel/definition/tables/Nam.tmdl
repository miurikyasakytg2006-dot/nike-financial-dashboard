table Nam

	measure 'Tỷ trọng NIKE Direct' = SUM ( Nam[direct_share] )
		formatString: 0.0%

	measure 'Tỷ trọng bán buôn' = SUM ( Nam[wholesale_share] )
		formatString: 0.0%

	measure 'Tỷ trọng Global Brand Divisions' = SUM ( Nam[gbd_share] )
		formatString: 0.00%

	measure 'NIKE Direct (tỷ USD)' = DIVIDE ( SUM ( Nam[nike_direct_revenue] ), 1000 )
		formatString: #,0.0

	measure 'Bán buôn (tỷ USD)' = DIVIDE ( SUM ( Nam[nike_brand_wholesale_revenue] ), 1000 )
		formatString: #,0.0

	measure 'NIKE Brand (tỷ USD)' = DIVIDE ( SUM ( Nam[nike_brand_revenue] ), 1000 )
		formatString: #,0.0

	measure 'Cơ sở đang chọn' = SELECTEDVALUE ( CoSo[Cơ sở], "Theo báo cáo" )

	measure 'Tăng trưởng NIKE Direct' = IF ( [Cơ sở đang chọn] = "Loại trừ tỷ giá", SUM ( Nam[nike_direct_pct_change_cn] ), SUM ( Nam[direct_growth] ) )
		formatString: +0.0%;-0.0%;0.0%

	measure 'Tăng trưởng bán buôn' = IF ( [Cơ sở đang chọn] = "Loại trừ tỷ giá", SUM ( Nam[nike_brand_wholesale_pct_change_cn] ), SUM ( Nam[wholesale_growth] ) )
		formatString: +0.0%;-0.0%;0.0%

	measure 'NIKE Direct theo báo cáo' = SUM ( Nam[direct_growth] )
		formatString: +0.0%;-0.0%;0.0%

	measure 'NIKE Direct loại trừ tỷ giá' = SUM ( Nam[nike_direct_pct_change_cn] )
		formatString: +0%;-0%;0%

	measure 'Bán buôn theo báo cáo' = SUM ( Nam[wholesale_growth] )
		formatString: +0.0%;-0.0%;0.0%

	measure 'Bán buôn loại trừ tỷ giá' = SUM ( Nam[nike_brand_wholesale_pct_change_cn] )
		formatString: +0%;-0%;0%

	measure 'Digital (tỷ USD)' = SUM ( Nam[nike_brand_digital_sales] )
		formatString: #,0.0

	measure 'Phần còn lại của NIKE Direct (tỷ USD)' = [NIKE Direct (tỷ USD)] - [Digital (tỷ USD)]
		formatString: #,0.0

	measure 'Digital trong NIKE Direct' = SUM ( Nam[digital_share_of_direct] )
		formatString: 0%

	measure 'Doanh thu (tỷ USD)' = DIVIDE ( SUM ( Nam[revenues] ), 1000 )
		formatString: #,0.0

	measure 'Tăng trưởng doanh thu' = SUM ( Nam[revenue_growth] )
		formatString: +0.0%;-0.0%;0.0%

	measure 'Tăng trưởng doanh thu loại trừ tỷ giá' = SUM ( Nam[revenues_pct_change_cn] )
		formatString: +0%;-0%;0%

	measure 'Biên lợi nhuận gộp' = SUM ( Nam[gross_margin] )
		formatString: 0.0%

	measure 'Lợi nhuận gộp (tỷ USD)' = DIVIDE ( SUM ( Nam[gross_profit] ), 1000 )
		formatString: #,0.0

	measure 'SG&A / doanh thu' = SUM ( Nam[sga_ratio] )
		formatString: 0.0%

	measure 'Vận hành chung / doanh thu' = SUM ( Nam[operating_overhead_ratio] )
		formatString: 0.0%

	measure 'Tạo nhu cầu / doanh thu' = SUM ( Nam[demand_creation_ratio] )
		formatString: 0.0%

	measure 'SG&A (tỷ USD)' = DIVIDE ( SUM ( Nam[total_selling_admin_expense] ), 1000 )
		formatString: #,0.0

	measure 'Biên EBIT' = SUM ( Nam[ebit_margin] )
		formatString: 0.0%

	measure 'EBIT do NIKE công bố (tỷ USD)' = DIVIDE ( SUM ( Nam[ebit_reported] ), 1000 )
		formatString: #,0.00

	measure 'Biên lợi nhuận sau thuế' = SUM ( Nam[net_income_margin] )
		formatString: 0.0%

	measure 'Hàng tồn kho (tỷ USD)' = DIVIDE ( SUM ( Nam[inventories] ), 1000 )
		formatString: #,0.0

	measure 'Thay đổi hàng tồn kho' = SUM ( Nam[inventory_growth] )
		formatString: +0.0%;-0.0%;0.0%

	measure 'Vòng quay hàng tồn kho' = SUM ( Nam[inventory_turnover] )
		formatString: 0.00

	measure 'Số ngày tồn kho' = SUM ( Nam[days_inventory] )
		formatString: 0.0

	measure 'Tồn kho bình quân (tỷ USD)' = DIVIDE ( SUM ( Nam[average_inventory] ), 1000 )
		formatString: #,0.00

	measure 'Giá vốn hàng bán (tỷ USD)' = DIVIDE ( SUM ( Nam[cost_of_sales] ), 1000 )
		formatString: #,0.0

	measure 'Tóm tắt kênh' =
			VAR a = MIN ( Nam[FY] )
			VAR b = MAX ( Nam[FY] )
			VAR n = DISTINCTCOUNT ( Nam[FY] )
			VAR shA = CALCULATE ( SUM ( Nam[direct_share] ), Nam[FY] = a )
			VAR shB = CALCULATE ( SUM ( Nam[direct_share] ), Nam[FY] = b )
			VAR hi = MINX ( TOPN ( 1, VALUES ( Nam[FY] ), CALCULATE ( SUM ( Nam[direct_share] ) ), DESC ), Nam[FY] )
			VAR lo = MINX ( TOPN ( 1, VALUES ( Nam[FY] ), CALCULATE ( SUM ( Nam[direct_share] ) ), ASC ), Nam[FY] )
			VAR shHi = CALCULATE ( SUM ( Nam[direct_share] ), Nam[FY] = hi )
			VAR shLo = CALCULATE ( SUM ( Nam[direct_share] ), Nam[FY] = lo )
			VAR wsA = CALCULATE ( SUM ( Nam[wholesale_share] ), Nam[FY] = a )
			VAR dA = CALCULATE ( SUM ( Nam[nike_direct_revenue] ), Nam[FY] = a ) / 1000
			VAR dB = CALCULATE ( SUM ( Nam[nike_direct_revenue] ), Nam[FY] = b ) / 1000
			VAR wA = CALCULATE ( SUM ( Nam[nike_brand_wholesale_revenue] ), Nam[FY] = a ) / 1000
			VAR wB = CALCULATE ( SUM ( Nam[nike_brand_wholesale_revenue] ), Nam[FY] = b ) / 1000
			RETURN
			    IF (
			        a = b,
			        "Trong FY" & a & ", NIKE Direct chiếm " & FORMAT ( shA, "0.0%", "vi-VN" ) & " doanh thu NIKE Brand ("
			            & FORMAT ( dA, "#,0.0", "vi-VN" ) & " tỷ USD); bán buôn chiếm " & FORMAT ( wsA, "0.0%", "vi-VN" ) & " ("
			            & FORMAT ( wA, "#,0.0", "vi-VN" ) & " tỷ USD).",
			        "Tỷ trọng NIKE Direct trong doanh thu NIKE Brand là " & FORMAT ( shA, "0.0%", "vi-VN" ) & " ở FY" & a & " và "
			            & FORMAT ( shB, "0.0%", "vi-VN" ) & " ở FY" & b
			            & IF ( n > 2, "; cao nhất " & FORMAT ( shHi, "0.0%", "vi-VN" ) & " (FY" & hi & "), thấp nhất "
			                & FORMAT ( shLo, "0.0%", "vi-VN" ) & " (FY" & lo & ")" )
			            & ". Doanh thu NIKE Direct từ " & FORMAT ( dA, "#,0.0", "vi-VN" ) & " đến " & FORMAT ( dB, "#,0.0", "vi-VN" )
			            & " tỷ USD; bán buôn từ " & FORMAT ( wA, "#,0.0", "vi-VN" ) & " đến " & FORMAT ( wB, "#,0.0", "vi-VN" ) & " tỷ USD."
			    )

	measure 'Tóm tắt kết quả' =
			VAR a = MIN ( Nam[FY] )
			VAR b = MAX ( Nam[FY] )
			VAR n = DISTINCTCOUNT ( Nam[FY] )
			VAR rA = CALCULATE ( SUM ( Nam[revenues] ), Nam[FY] = a ) / 1000
			VAR rB = CALCULATE ( SUM ( Nam[revenues] ), Nam[FY] = b ) / 1000
			VAR gA = CALCULATE ( SUM ( Nam[gross_margin] ), Nam[FY] = a )
			VAR gB = CALCULATE ( SUM ( Nam[gross_margin] ), Nam[FY] = b )
			VAR eA = CALCULATE ( SUM ( Nam[ebit_margin] ), Nam[FY] = a )
			VAR eB = CALCULATE ( SUM ( Nam[ebit_margin] ), Nam[FY] = b )
			VAR yHi = MINX ( TOPN ( 1, VALUES ( Nam[FY] ), CALCULATE ( SUM ( Nam[ebit_margin] ) ), DESC ), Nam[FY] )
			VAR eHi = CALCULATE ( SUM ( Nam[ebit_margin] ), Nam[FY] = yHi )
			VAR iA = CALCULATE ( SUM ( Nam[inventories] ), Nam[FY] = a ) / 1000
			VAR iB = CALCULATE ( SUM ( Nam[inventories] ), Nam[FY] = b ) / 1000
			RETURN
			    IF (
			        a = b,
			        "Trong FY" & a & ", doanh thu NIKE, Inc. là " & FORMAT ( rA, "#,0.0", "vi-VN" ) & " tỷ USD, biên lợi nhuận gộp "
			            & FORMAT ( gA, "0.0%", "vi-VN" ) & ", biên EBIT (non-GAAP) " & FORMAT ( eA, "0.0%", "vi-VN" )
			            & ", hàng tồn kho cuối kỳ " & FORMAT ( iA, "#,0.0", "vi-VN" ) & " tỷ USD.",
			        "Doanh thu NIKE, Inc. từ " & FORMAT ( rA, "#,0.0", "vi-VN" ) & " (FY" & a & ") đến " & FORMAT ( rB, "#,0.0", "vi-VN" )
			            & " tỷ USD (FY" & b & "). Biên lợi nhuận gộp " & FORMAT ( gA, "0.0%", "vi-VN" ) & " và " & FORMAT ( gB, "0.0%", "vi-VN" )
			            & "; biên EBIT (non-GAAP) " & FORMAT ( eA, "0.0%", "vi-VN" ) & " và " & FORMAT ( eB, "0.0%", "vi-VN" )
			            & IF ( n > 2, ", cao nhất " & FORMAT ( eHi, "0.0%", "vi-VN" ) & " (FY" & yHi & ")" )
			            & ". Hàng tồn kho cuối kỳ từ " & FORMAT ( iA, "#,0.0", "vi-VN" ) & " đến " & FORMAT ( iB, "#,0.0", "vi-VN" ) & " tỷ USD."
			    )

	measure 'Phụ đề tăng trưởng' = IF ( [Cơ sở đang chọn] = "Loại trừ tỷ giá", "% so với năm trước loại trừ tỷ giá, NIKE Brand. Số NIKE công bố (non-GAAP).", "% so với năm trước theo báo cáo, NIKE Brand. Tính toán từ 10-K." )

