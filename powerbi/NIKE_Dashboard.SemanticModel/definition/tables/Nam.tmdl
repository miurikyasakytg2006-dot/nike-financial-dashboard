	partition Nam = m
		mode: import
		source =
				let
				    Source = #table(type table [#"FY" = Int64.Type, #"Năm" = text, #"Năm (ngắn)" = text, #"Báo cáo" = text, #"Kỳ báo cáo" = text, #"Ngày nộp SEC" = text, #"Số accession" = text, #"Liên kết SEC EDGAR" = text, #"revenues" = number, #"cost_of_sales" = number, #"gross_profit" = number, #"demand_creation_expense" = number, #"operating_overhead_expense" = number, #"total_selling_admin_expense" = number, #"interest_expense_net" = number, #"other_expense_net" = number, #"income_before_taxes" = number, #"income_tax_expense" = number, #"net_income" = number, #"inventories" = number, #"ebit_reported" = number, #"revenues_pct_change_reported" = number, #"revenues_pct_change_cn" = number, #"nike_direct_revenue" = number, #"nike_brand_wholesale_revenue" = number, #"global_brand_divisions_revenue" = number, #"nike_brand_revenue" = number, #"converse_revenue" = number, #"corporate_revenue" = number, #"nike_brand_digital_sales" = number, #"nike_direct_share_stated" = number, #"nike_direct_pct_change_reported" = number, #"nike_direct_pct_change_cn" = number, #"nike_brand_wholesale_pct_change_reported" = number, #"nike_brand_wholesale_pct_change_cn" = number, #"nike_brand_pct_change_reported" = number, #"nike_brand_pct_change_cn" = number, #"direct_share" = number, #"wholesale_share" = number, #"gbd_share" = number, #"direct_growth" = number, #"wholesale_growth" = number, #"nike_brand_growth" = number, #"digital_share_of_direct" = number, #"revenue_growth" = number, #"gross_margin" = number, #"sga_ratio" = number, #"demand_creation_ratio" = number, #"operating_overhead_ratio" = number, #"ebit" = number, #"ebit_margin" = number, #"net_income_margin" = number, #"inventory_growth" = number, #"average_inventory" = number, #"inventory_turnover" = number, #"days_inventory" = number], {
