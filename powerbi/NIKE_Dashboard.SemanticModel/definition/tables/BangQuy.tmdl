		sortByColumn: 'Thứ tự cột'

	column 'Thứ tự cột'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự cột

	column 'Loại'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Loại

	column 'Hiển thị'
		dataType: string
		summarizeBy: none
		sourceColumn: Hiển thị

	column 'Liên kết'
		dataType: string
		summarizeBy: none
		sourceColumn: Liên kết
		dataCategory: WebUrl

