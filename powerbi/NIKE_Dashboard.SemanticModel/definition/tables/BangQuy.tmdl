table BangQuy

	measure 'Giá trị BangQuy' = COALESCE ( SELECTEDVALUE ( BangQuy[Hiển thị] ), "" )

	measure 'Liên kết BangQuy' = SELECTEDVALUE ( BangQuy[Liên kết] )

	measure 'Màu chữ BangQuy' = IF ( SELECTEDVALUE ( BangQuy[Loại] ) = "Trang", "#6f7784", "#15191e" )

	column 'Thứ tự'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự

	column 'Chỉ tiêu'
		dataType: string
		summarizeBy: none
		sourceColumn: Chỉ tiêu
		sortByColumn: 'Thứ tự'

	column 'Kỳ'
		dataType: string
		isHidden
		summarizeBy: none
