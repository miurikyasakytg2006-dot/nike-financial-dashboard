table BangKetQua

	measure 'Giá trị BangKetQua' = COALESCE ( SELECTEDVALUE ( BangKetQua[Hiển thị] ), "" )

	measure 'Liên kết BangKetQua' = SELECTEDVALUE ( BangKetQua[Liên kết] )

	column 'Thứ tự'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự

	column 'Chỉ tiêu'
		dataType: string
		summarizeBy: none
		sourceColumn: Chỉ tiêu
		sortByColumn: 'Thứ tự'

	column FY
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: FY

	column 'Hiển thị'
		dataType: string
		summarizeBy: none
		sourceColumn: Hiển thị

	column 'Liên kết'
		dataType: string
		summarizeBy: none
		sourceColumn: Liên kết
		dataCategory: WebUrl

	partition BangKetQua = m
		mode: import
