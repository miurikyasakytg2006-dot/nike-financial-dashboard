table BangKetQua

	measure 'Giá trị BangKetQua' = IF ( NOT ISEMPTY ( BangKetQua ), COALESCE ( SELECTEDVALUE ( BangKetQua[Hiển thị] ), "" ) )

	measure 'Liên kết BangKetQua' = SELECTEDVALUE ( BangKetQua[Liên kết] )

	measure 'Màu chữ BangKetQua' = IF ( SELECTEDVALUE ( BangKetQua[Loại] ) = "Trang", "#6f7784", "#15191e" )

	column 'Thứ tự'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự

	column 'Chỉ tiêu'
		dataType: string
		summarizeBy: none
		sourceColumn: Chỉ tiêu
		sortByColumn: 'Thứ tự'

	column FY
		dataType: int64
		formatString: 0
		isHidden
		summarizeBy: none
		sourceColumn: FY

	column 'Cột'
		dataType: string
		summarizeBy: none
		sourceColumn: Cột
		sortByColumn: 'Thứ tự cột'

	column 'Thứ tự cột'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự cột

	column 'Loại'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Loại

	column 'Hiển thị'
		dataType: string
		summarizeBy: none
		sourceColumn: Hiển thị

	column 'Liên kết'
		dataType: string
		summarizeBy: none
		sourceColumn: Liên kết
		dataCategory: WebUrl

	partition BangKetQua = m
		mode: import
		source =
