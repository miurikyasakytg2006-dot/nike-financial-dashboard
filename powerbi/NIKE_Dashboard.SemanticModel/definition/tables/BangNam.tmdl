table BangNam

	measure 'Giá trị BangNam' = COALESCE ( SELECTEDVALUE ( BangNam[Hiển thị] ), "" )

	measure 'Liên kết BangNam' = SELECTEDVALUE ( BangNam[Liên kết] )

	measure 'Màu chữ BangNam' = IF ( SELECTEDVALUE ( BangNam[Loại] ) = "Trang", "#6f7784", "#15191e" )

	column 'Thứ tự'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự

	column 'Chỉ tiêu'
		dataType: string
		summarizeBy: none
		sourceColumn: Chỉ tiêu
		sortByColumn: 'Thứ tự'

	column 'Kỳ'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Kỳ

	column 'Cột'
		dataType: string
		summarizeBy: none
		sourceColumn: Cột
		sortByColumn: 'Thứ tự cột'

	column 'Thứ tự cột'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự cột

	column 'Loại'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Loại

	column 'Hiển thị'
		dataType: string
		summarizeBy: none
		sourceColumn: Hiển thị

	column 'Liên kết'
		dataType: string
		summarizeBy: none
		sourceColumn: Liên kết
		dataCategory: WebUrl

	partition BangNam = m
		mode: import
		source =
				let
