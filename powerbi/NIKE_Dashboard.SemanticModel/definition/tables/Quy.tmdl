table Quy

	measure 'Tỷ trọng NIKE Direct (quý)' = SUM ( Quy[direct_share] )
		formatString: 0.0%

	measure 'Tỷ trọng bán buôn (quý)' = SUM ( Quy[wholesale_share] )
		formatString: 0.0%

	measure 'Tỷ trọng Global Brand Divisions (quý)' = SUM ( Quy[gbd_share] )
		formatString: 0.00%

	measure 'NIKE Direct (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[nike_direct_revenue] ), 1000 )
		formatString: #,0.0

	measure 'Bán buôn (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[nike_brand_wholesale_revenue] ), 1000 )
		formatString: #,0.0

	measure 'NIKE Brand (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[nike_brand_revenue] ), 1000 )
		formatString: #,0.0

	measure 'Tăng trưởng NIKE Direct (quý)' = SUM ( Quy[direct_growth] )
		formatString: +0.0%;−0.0%;0.0%

	measure 'Tăng trưởng bán buôn (quý)' = SUM ( Quy[wholesale_growth] )
		formatString: +0.0%;−0.0%;0.0%

	measure 'Digital (tỷ USD) (quý)' = SUM ( Quy[nike_brand_digital_sales] )
		formatString: #,0.0

	measure 'Phần còn lại của NIKE Direct (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[direct_ex_digital] ), 1000 )
		formatString: #,0.0

	measure 'Digital trong NIKE Direct (quý)' = SUM ( Quy[digital_share_of_direct] )
		formatString: 0%

	measure 'Doanh thu (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[revenues] ), 1000 )
		formatString: #,0.0

	measure 'Biên lợi nhuận gộp (quý)' = SUM ( Quy[gross_margin] )
		formatString: 0.0%

	measure 'Biên EBIT (quý)' = SUM ( Quy[ebit_margin] )
		formatString: 0.0%

	measure 'Hàng tồn kho (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[inventories] ), 1000 )
		formatString: #,0.0

	measure 'So với cùng thời điểm năm trước (quý)' = SUM ( Quy[inventory_growth] )
		formatString: +0.0%;−0.0%;0.0%

	measure 'Số ngày tồn kho (quý)' = SUM ( Quy[days_inventory] )
		formatString: 0

	measure 'Giá vốn hàng bán (tỷ USD) (quý)' = DIVIDE ( SUM ( Quy[cost_of_sales] ), 1000 )
		formatString: #,0.00

