table BangKhuVuc

	measure 'Giá trị BangKhuVuc' = COALESCE ( SELECTEDVALUE ( BangKhuVuc[Hiển thị] ), "" )

	measure 'Liên kết BangKhuVuc' = SELECTEDVALUE ( BangKhuVuc[Liên kết] )

	measure 'Màu chữ BangKhuVuc' = IF ( SELECTEDVALUE ( BangKhuVuc[Loại] ) = "Trang", "#6f7784", "#15191e" )

	column 'Thứ tự'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự

	column 'Chỉ tiêu'
		dataType: string
		summarizeBy: none
		sourceColumn: Chỉ tiêu
		sortByColumn: 'Thứ tự'

	column 'Kỳ'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Kỳ

	column 'Cột'
		dataType: string
		summarizeBy: none
		sourceColumn: Cột
		sortByColumn: 'Thứ tự cột'

	column 'Thứ tự cột'
		dataType: int64
		isHidden
		summarizeBy: none
		sourceColumn: Thứ tự cột

	column 'Loại'
		dataType: string
		isHidden
		summarizeBy: none
		sourceColumn: Loại

	column 'Hiển thị'
		dataType: string
		summarizeBy: none
		sourceColumn: Hiển thị

	column 'Liên kết'
		dataType: string
		summarizeBy: none
		sourceColumn: Liên kết
		dataCategory: WebUrl

